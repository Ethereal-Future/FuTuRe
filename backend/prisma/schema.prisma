generator client {
  provider = "prisma-client-js"
}

// In Prisma 7, datasource configuration moved to prisma.config.js
// The DATABASE_URL is configured there and passed via the adapter pattern
datasource db {
  provider = "postgresql"
}

model User {
  id                     String                  @id @default(uuid())
  publicKey              String                  @unique
  username               String?                 @unique
  passwordHash           String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  deletedAt              DateTime?
  amlStatus              String                  @default("CLEAR")  // CLEAR, HELD_FOR_REVIEW, BLOCKED
  amlHoldReason          String?                 // Reason why account is held
  amlHoldDate            DateTime?               // When the hold was placed
  settings               Setting?
  sentTxs                Transaction[]           @relation("sender")
  receivedTxs            Transaction[]           @relation("recipient")
  sentStreams            PaymentStream[]         @relation("streamSender")
  receivedStreams        PaymentStream[]         @relation("streamRecipient")
  notifications          Notification[]
  notificationPreference NotificationPreference?
  kycRecord              KYCRecord?
  amlAlerts              AMLAlert[]
  auditLogs              AuditLog[]
  webAuthnCredentials    WebAuthnCredential[]
  contacts               Contact[]
  role                   UserRole                @default(USER)
  sessions               Session[]
  mfaSettings            MFASettings?
  recoveryCodes          RecoveryCode[]

  @@index([deletedAt])
  @@index([amlStatus])
}

model Transaction {
  id            String         @id @default(uuid())
  hash          String         @unique
  assetCode     String         @default("XLM")
  amount        Decimal
  ledger        Int?
  successful    Boolean        @default(true)
  memo          String?
  memoType      String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  senderId      String
  sender        User           @relation("sender", fields: [senderId], references: [id])
  recipientId   String
  recipient     User           @relation("recipient", fields: [recipientId], references: [id])
  retryAttempts Int            @default(0)
  retryStatus   String?
  lastRetryAt   DateTime?
  retryHistory  RetryAttempt[]
  amlAlerts     AMLAlert[]

  @@index([deletedAt])
  @@index([senderId, createdAt])
  @@index([recipientId, createdAt])
}

model RetryAttempt {
  id            String      @id @default(uuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  attemptNumber Int
  errorType     String
  errorMessage  String
  timestamp     DateTime    @default(now())

  @@index([transactionId])
}

model Setting {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultAsset    String   @default("XLM")
  notificationsOn Boolean  @default(true)
  accountLabel    String?
  federationAddress String? @unique
  // XLM amount above which a WebAuthn biometric re-auth is required before a
  // payment is confirmed. Null falls back to the server default (issue #808).
  biometricReauthThreshold Float?
  updatedAt       DateTime @updatedAt
}

enum UserRole {
  USER
  COMPLIANCE
  ADMIN
}

enum StreamStatus {
  ACTIVE
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

model PaymentStream {
  id              String         @id @default(uuid())
  senderId        String
  sender          User           @relation("streamSender", fields: [senderId], references: [id])
  recipientId     String
  recipient       User           @relation("streamRecipient", fields: [recipientId], references: [id])
  assetCode       String         @default("XLM")
  rateAmount      Decimal
  intervalSeconds Int            @default(60)
  startTime       DateTime       @default(now())
  endTime         DateTime?
  lastProcessedAt DateTime       @default(now())
  totalStreamed    Decimal        @default(0)
  status          StreamStatus   @default(ACTIVE)
  failureCount    Int            @default(0)
  metadata        Json?
  senderSecret    String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  failures        StreamFailure[]

  @@index([senderId])
  @@index([recipientId])
  @@index([status, lastProcessedAt])
}

model StreamFailure {
  id        String        @id @default(uuid())
  streamId  String
  stream    PaymentStream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  reason    String
  createdAt DateTime      @default(now())

  @@index([streamId, createdAt])
}

model Notification {
  id                 String   @id @default(uuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type               String
  channel            String
  status             String   @default("sent")
  title              String?
  body               String
  read               Boolean  @default(false)
  actionUrl          String?
  actionRetryParams  Json?
  metadata           Json?
  createdAt          DateTime @default(now())
  deletedAt          DateTime?

  @@index([userId, createdAt])
  @@index([userId, read])
  @@index([userId, deletedAt])
}

model NotificationPreference {
  id                        String   @id @default(uuid())
  userId                    String   @unique
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailEnabled              Boolean  @default(true)
  pushEnabled               Boolean  @default(true)
  smsEnabled                Boolean  @default(false)
  inAppEnabled              Boolean  @default(true)
  quietHoursStart           Int      @default(22)
  quietHoursEnd             Int      @default(7)
  typeOverrides             Json?
  weeklyDigestEnabled       Boolean  @default(false)
  weeklyDigestDay           Int      @default(1)
  weeklyDigestTime          Int      @default(9)
  lowBalanceAlertEnabled    Boolean  @default(false)
  lowBalanceThreshold       Decimal  @default(10.0)
  lowBalanceAsset           String   @default("XLM")
  lastLowBalanceAlertAt     DateTime?
  lastLowBalanceAlertLevel  Decimal?
  updatedAt                 DateTime @updatedAt
}

model KYCRecord {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status         String   @default("PENDING")
  fullName       String
  dateOfBirth    DateTime
  nationality    String
  documentType   String
  documentNumber String
  address        String
  phoneNumber    String?
  email          String?
  riskScore      Int?
  riskLevel      String?
  submittedAt    DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
}

model AMLAlert {
  id            String      @id @default(uuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  ruleId        String
  severity      String
  description   String
  riskScore     Int
  riskLevel     String
  createdAt     DateTime    @default(now())

  @@index([transactionId])
  @@index([userId])
}

model WebAuthnCredential {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String   @unique
  publicKey    String
  counter      BigInt   @default(0)
  deviceName   String?
  createdAt    DateTime @default(now())

  @@index([userId])
}

model AuditLog {
  id            String   @id @default(uuid())
  timestamp     DateTime @default(now())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  actionType    String
  resourceType  String?
  resourceId    String?
  details       String
  ipAddress     String?
  userAgent     String?
  outcome       String   @default("SUCCESS")
  severity      String   @default("INFO")

  @@index([timestamp])
  @@index([userId])
  @@index([actionType])
  @@index([severity])
}

model ClientError {
  id             String   @id @default(uuid())
  message        String
  stack          String?
  componentStack String?
  context        String?
  url            String?
  userAgent      String?
  userId         String?
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@index([createdAt])
  @@index([context])
}

model Contact {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  address   String
  createdAt DateTime @default(now())

  @@unique([userId, address])
  @@index([userId])
}

model MFASettings {
  id        String    @id @default(uuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secret    String?   // encrypted TOTP secret
  enabled   Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  lastUsed  DateTime?
}

model RecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    // bcrypt hash of recovery code
  used      Boolean   @default(false)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Session {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  device       String?
  ipAddress    String?
  userAgent    String?
  lastActiveAt DateTime  @default(now())
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?

  @@index([userId])
  @@index([userId, revokedAt])
}

// Immutable audit trail for all admin actions (no UPDATE/DELETE should be issued against this table)
model AdminAuditLog {
  id               String   @id @default(uuid())
  adminUserId      String
  actionType       String
  targetEntityType String
  targetEntityId   String
  actionMetadata   Json     @default("{}")
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime @default(now())

  @@index([adminUserId])
  @@index([actionType])
  @@index([createdAt])
}

// OAuth2 client registrations – replaces the in-memory Map in
// backend/src/security/oauth2.js. Stores registered OAuth2 clients
// (first-party and partner integrations).
model OAuth2Client {
  id           String   @id @default(uuid())
  clientId     String   @unique
  clientSecret String
  redirectUris String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  authorizationCodes OAuth2AuthorizationCode[]
  tokens             OAuth2Token[]

  @@index([clientId])
}

// OAuth2 authorization codes – replaces the in-memory Map in
// backend/src/security/oauth2.js. Short-lived codes (10 minutes)
// that are exchanged for access/refresh tokens.
model OAuth2AuthorizationCode {
  id        String        @id @default(uuid())
  code      String        @unique
  clientId  String
  client    OAuth2Client  @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId    String
  scope     String
  expiresAt DateTime
  createdAt DateTime      @default(now())

  @@index([code])
  @@index([clientId])
  @@index([expiresAt])
}

// OAuth2 access and refresh tokens – replaces the in-memory Map in
// backend/src/security/oauth2.js. Refresh tokens now have an expiry
// (90 days default) to comply with security best practices.
model OAuth2Token {
  id           String       @id @default(uuid())
  refreshToken String       @unique
  clientId     String
  client       OAuth2Client @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId       String
  scope        String
  createdAt    DateTime     @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?

  @@index([refreshToken])
  @@index([clientId])
  @@index([userId])
  @@index([expiresAt])
}

enum IncidentType {
  UNAUTHORIZED_ACCESS
  DATA_BREACH
  MALWARE_DETECTED
  DDoS_ATTACK
}

enum IncidentStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// Security incidents – replaces the in-memory Map + JSON files in
// backend/src/security/incidentResponse.js. Provides durable storage
// for security incident tracking and response.
model SecurityIncident {
  id              String           @id @default(uuid())
  incidentId      String           @unique // e.g., INC-1234567890
  type            IncidentType
  severity        IncidentSeverity
  status          IncidentStatus   @default(OPEN)
  description     String
  affectedSystems String[]
  playbook        String[]         // List of actions from response playbook
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  actions IncidentAction[]
  notes   IncidentNote[]

  @@index([incidentId])
  @@index([status])
  @@index([createdAt])
}

// Completed actions for security incidents
model IncidentAction {
  id         String           @id @default(uuid())
  incidentId String
  incident   SecurityIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  action     String
  completedAt DateTime        @default(now())

  @@index([incidentId])
}

// Notes and updates for security incidents
model IncidentNote {
  id         String           @id @default(uuid())
  incidentId String
  incident   SecurityIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  content    String
  timestamp  DateTime         @default(now())

  @@index([incidentId])
}

// Persisted webhook registrations – replaces the in-memory Map in
// backend/src/webhooks/store.js.  A soft-delete column (deletedAt) is used so
// that the row remains available for foreign-key joins against WebhookDelivery
// while being hidden from all normal queries.
model Webhook {
  id              String    @id @default(uuid())
  accountId       String
  url             String
  events          String[]
  signingSecret   String
  previousSecrets String[]  @default([])
  createdAt       DateTime  @default(now())
  lastRotatedAt   DateTime  @default(now())
  deletedAt       DateTime?

  deliveries WebhookDelivery[]

  @@index([accountId])
  @@index([accountId, deletedAt])
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

// Durable record of every dispatched webhook event, one row per attempt cycle.
// Replaces the previous fire-and-forget setTimeout retry loop so pending
// retries survive process restarts and account owners can query failures.
model WebhookDelivery {
  id            String                @id @default(uuid())
  webhookId     String
  webhook       Webhook               @relation(fields: [webhookId], references: [id])
  accountId     String
  eventType     String
  payload       Json
  attempt       Int                   @default(0)
  maxAttempts   Int                   @default(3)
  status        WebhookDeliveryStatus @default(PENDING)
  lastError     String?
  nextAttemptAt DateTime              @default(now())
  deliveredAt   DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([webhookId, createdAt])
  @@index([accountId, createdAt])
  @@index([status, nextAttemptAt])
}

model IPWhitelist {
  id        String   @id @default(uuid())
  ipAddress String   @unique
  cidr      String?  // CIDR notation if applicable
  reason    String?  // Why this IP was whitelisted
  addedBy   String?  // Admin who added this entry
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ipAddress])
  @@index([createdAt])
}

// Tracks a SEP-0031 cross-border direct payment handed off to a receiving
// anchor. One row per transaction created via POST /transactions against an
// anchor's DIRECT_PAYMENT_SERVER; status is refreshed by polling
// GET /transactions/:id. See issue #955.
model Sep31Transaction {
  id                String   @id @default(uuid())
  anchorUrl         String
  externalId        String
  status            String   @default("pending_sender")
  amount            String
  assetCode         String?
  senderPublicKey   String?
  receiverPublicKey String?
  stellarAccountId  String?
  stellarMemo       String?
  stellarMemoType   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([anchorUrl, externalId])
  @@index([status])
}


// Real Horizon fee-stats snapshots persisted by the scheduler every 5 minutes.
// getFeeHistory() queries this table instead of generating synthetic data.
// See issue #1119.
model FeeSnapshot {
  id         String   @id @default(uuid())
  capturedAt DateTime @default(now())
  baseFee    Int      // last_ledger_base_fee (stroops)
  p10        Int      // fee_charged.p10
  p50        Int      // fee_charged.p50
  p75        Int      // fee_charged.p75
  p90        Int      // fee_charged.p90
  p99        Int      // fee_charged.p99
  peakFee    Int      // peak_fee.p99

  @@index([capturedAt])
}
